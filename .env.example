# ReadPilot local configuration

# Optional. Defaults to ./data.
READPILOT_DATA_DIR=./data

# Optional. Defaults to ${READPILOT_DATA_DIR}/books.
READPILOT_BOOKS_DIR=./data/books

# Optional. Used by helper scripts that call the local app.
READPILOT_BASE_URL=http://localhost:3000

# Optional on Windows if Claude Code needs an explicit Git Bash path.
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# Optional. ChatPanel coding-agent backend. Supported: claude, codex.
# Hermes is reserved for a future CLI adapter and currently returns a provider warning.
READPILOT_AGENT_PROVIDER=claude

# Optional. Codex provider settings. Requires Codex CLI auth (`codex login`) or CODEX_API_KEY/OPENAI_API_KEY.
# READPILOT_CODEX_MODEL=
# CODEX_CLI_PATH=
# CODEX_API_KEY=

# Optional if your Claude Code setup uses API-key auth.
# Do not commit real secrets.
# ANTHROPIC_API_KEY=
